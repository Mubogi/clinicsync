# Server
PORT=5000
DATABASE_URL=postgresql://clinicsync:clinicsync@localhost:5432/clinicsync
JWT_SECRET=change-me-to-a-long-random-string

# Client (Vite dev proxy target)
VITE_API_URL=/api

# Show the seeded demo PINs on the login screen. Off in production builds:
# leaving it on would publish the demo owner's PIN to every visitor. Set to 1
# only for a throwaway public demo instance.
VITE_SHOW_DEMO_LOGINS=

# CORS origins (comma separated)
CORS_ORIGINS=http://localhost:5173

# Platform admin: comma-separated user ids allowed to open /admin and manage
# every clinic's plan (activate, extend, suspend). Leave empty to disable the
# admin console entirely — that is the safe default.
SYS_ADMIN_IDS=

# Days a monthly backup is kept before pruning
BACKUP_RETENTION_DAYS=400