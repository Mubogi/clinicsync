datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============ SUBSCRIPTION / SAAS ============

// Tier catalogue (static definitions — matches lib/utils TIERS on client)
enum SubscriptionTier {
  BASIC
  PREMIUM
  PRO
}

// Lifecycle of a self-service payment claim awaiting admin verification.
// A clinic picks a plan, pays to the JD Hub collection till, then submits the
// transaction reference; the admin confirms it and the paid period starts.
enum PaymentRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Facility {
  id                  String                @id @default(uuid())
  name                String                @unique
  slug                String?               @unique // URL-friendly org slug
  subscriptionTier    SubscriptionTier      @default(BASIC) // BASIC, PREMIUM, PRO
  // Branding (owner-only editable)
  brandName           String? // Display name shown across the whole system
  tagline             String?
  logoEmoji           String?
  address             String?
  phone               String?
  // Owner contact captured at signup. Used to send payment/activation notices,
  // and as the email connection for JD Hub enquiries.
  email               String?
  // Onboarding: whether the owner has finished first-time setup (clinic details,
  // medicine library pick). Set true on first login through the setup flow.
  onboarded           Boolean               @default(false)
  inviteCode          String?               @unique // staff join link token (owner-generated)
  // ---- Subscription lifecycle (managed from the platform admin panel) ----
  // When the current paid period ends. Past this date the facility is treated
  // as BASIC by getEffectiveTier(), without the stored tier being rewritten, so
  // renewing restores the plan exactly as it was.
  subscriptionEndsAt  DateTime?
  // Free-trial window for a self-registered clinic. Billing is manual, so
  // without this a clinic could not use the product at all until an admin
  // manually approved their first payment — which stalls signup overnight.
  // Expiry is evaluated the same way as a lapsed subscription.
  trialEndsAt         DateTime?
  // Manual switch to cut a clinic off (non-payment, abuse) without deleting it.
  suspended           Boolean               @default(false)
  suspendedReason     String?
  // Brute-force defence for the shared-PIN login. A 4-digit PIN is only 10,000
  // combinations, and an attacker can rotate IPs past the per-IP rate limit, so
  // the clinic itself is locked after repeated failures.
  failedLoginAttempts Int                   @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  users               User[]
  inventories         Inventory[]
  sales               Sale[]
  expenses            Expense[]
  reconciliations     DailyReconciliation[]
  products            Product[]
  priceHistory        PriceHistory[]
  stockMovements      StockMovement[]
  rememberTokens      RememberToken[]
  invites             FacilityInvite[]
  deleteRequests      DeleteRequest[]
  backups             Backup[]
  payments            Payment[]
  paymentRequests     PaymentRequest[]
}

// A clinic's self-service claim that it has paid for a plan. The clinic picks a
// tier, sends money to the JD Hub collection till, then submits the reference.
// An admin verifies it against the till statement and approves, which is what
// actually starts the paid period — so a forged claim grants nothing on its own.
model PaymentRequest {
  id              String               @id @default(uuid())
  facilityId      String
  facility        Facility             @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  requestedTier   SubscriptionTier
  months          Int                  @default(1)
  amountUgx       Int                  @default(0)
  method          String               @default("AIRTEL") // AIRTEL | MTN
  payerName       String?
  payerPhone      String?
  transactionRef  String // the till transaction ID the payer was given
  note            String?
  status          PaymentRequestStatus @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime             @default(now())

  @@index([facilityId, status])
}

// Audit trail of plan activations/extensions, so a clinic's billing history is
// reconstructable when they dispute what they paid for.
model Payment {
  id          String           @id @default(uuid())
  facilityId  String
  facility    Facility         @relation(fields: [facilityId], references: [id])
  tier        SubscriptionTier
  months      Int
  amountUgx   Int              @default(0)
  note        String?
  periodStart DateTime
  periodEnd   DateTime
  createdAt   DateTime         @default(now())
  recordedBy  String? // admin user id / label
}

// Append-only record of every platform-admin action. Payments and stock have
// their own trails, but "who suspended this clinic" and "who changed that tier"
// previously left no trace at all. Rows are only ever inserted.
model AdminAudit {
  id         String   @id @default(uuid())
  actorId    String // the operator's user id
  actorName  String?
  action     String // e.g. ACTIVATE, SUSPEND, USER_DEACTIVATE, TIER_CHANGE
  facilityId String? // clinic acted upon, when applicable
  targetId   String? // user id / facility id the action targeted
  detail     String? // short human-readable summary
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([facilityId])
}

// Remember-me persistent sessions (per user+facility, auto-expire)
model RememberToken {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model User {
  id           String          @id @default(uuid())
  facilityId   String
  facility     Facility        @relation(fields: [facilityId], references: [id])
  name         String
  role         String // OWNER, PHARMACIST, CASHIER
  pinCode      String
  // Owner-facing sign-in. PIN alone is fine for a shared till, but the owner
  // uses their own device and gets a real password. Globally unique because
  // password login does not ask which clinic you belong to.
  username     String?         @unique
  passwordHash String?
  active       Boolean         @default(true) // disables login when owner "removes" user
  createdAt    DateTime        @default(now())
  sales        Sale[] // accountability: every sale attributed to cashier
  rememberT    RememberToken[]
  movements    StockMovement[]
}

// ============ CATALOG / PRICING ============

// A product belongs to a facility, sellable in multiple units (tablet/strip/box)
model Product {
  id              String         @id @default(uuid())
  facilityId      String
  facility        Facility       @relation(fields: [facilityId], references: [id])
  name            String
  genericName     String?
  // Pricing per unit — a small shop can sell per tablet, strip AND box
  tabletPrice     Float?
  stripPrice      Float?
  boxPrice        Float?
  // Purchased (cost) — used to compute expected revenue
  costPrice       Float          @default(0)
  // Pack composition ("I bought a box, how do I price a strip & tablet?")
  stripsPerBox    Int? // how many strips are inside one box
  tabletsPerStrip Int? // how many tablets are inside one strip
  // Reorder guidance in each unit (show "low" when stock <= reorder)
  reorderTablets  Int?           @default(50)
  reorderStrips   Int?           @default(10)
  reorderBoxes    Int?           @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  inventories     Inventory[] // stock batches with expiry
  priceHistory    PriceHistory[]
}

model PriceHistory {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  oldCost    Float?
  newCost    Float?
  oldSell    Float?
  newSell    Float?
  changedBy  String? // user id
  createdAt  DateTime @default(now())
}

// ============ STOCK / BATCHES ============

// A stock line = a batch of a product at an expiry, in a given unit
model Inventory {
  id           String          @id @default(uuid())
  facilityId   String
  facility     Facility        @relation(fields: [facilityId], references: [id])
  productId    String?
  product      Product?        @relation(fields: [productId], references: [id])
  drugName     String // denormalized search label
  unitType     String // Tablet, Strip, Bottle, Box
  quantity     Int
  costPrice    Float
  sellingPrice Float // price of ONE of `unitType`
  expiryDate   DateTime?
  supplier     String?
  batch        String?
  reorderLevel Int             @default(10)
  syncStatus   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]
}

// Audit of every stock change (restock, sale, adjustment) for provider attribution
model StockMovement {
  id          String    @id @default(uuid())
  facilityId  String
  facility    Facility  @relation(fields: [facilityId], references: [id])
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  delta       Int // +restock, -sale
  reason      String // SALE, RESTOCK, ADJUSTMENT, EXPIRED
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}

// ============ SALES / CASHIER ACCOUNTABILITY ============

model Sale {
  id            String     @id @default(uuid())
  facilityId    String
  facility      Facility   @relation(fields: [facilityId], references: [id])
  // Cashier attribution
  userId        String?
  user          User?      @relation(fields: [userId], references: [id])
  cashierName   String? // snapshot in case user removed
  receiptNumber Int        @default(autoincrement())
  totalAmount   Float
  cashPaid      Float
  momoPaid      Float
  paymentMethod String     @default("CASH") // CASH, MOMO, MIXED
  momoNetwork   String? // MTN, AIRTEL
  createdAt     DateTime   @default(now())
  syncStatus    Boolean    @default(false)
  items         SaleItem[]
}

model SaleItem {
  id          String  @id @default(uuid())
  saleId      String
  sale        Sale    @relation(fields: [saleId], references: [id])
  inventoryId String? // which batch was sold (FEFO)
  productId   String? // which product
  drugName    String
  unitType    String? // what unit it was sold in (Tablet/Strip/Box)
  quantity    Int // number of units sold
  unitPrice   Float // per-unit sell price (the SKU level)
  totalPrice  Float
  costPrice   Float // snapshot: what it cost at sale time (for profit)
}

model Expense {
  id          String   @id @default(uuid())
  facilityId  String
  facility    Facility @relation(fields: [facilityId], references: [id])
  category    String // YAKA, Transport, Allowance, Packaging, Water
  amount      Float
  description String?
  createdAt   DateTime @default(now())
  syncStatus  Boolean  @default(false)
}

model DailyReconciliation {
  id               String   @id @default(uuid())
  facilityId       String
  facility         Facility @relation(fields: [facilityId], references: [id])
  date             DateTime @default(now())
  totalRevenue     Float
  totalExpenses    Float
  expectedCash     Float
  momoBalance      Float
  drugsBoughtTotal Float
  isClosed         Boolean  @default(false)
  createdAt        DateTime @default(now())
}

// ============ STAFF JOIN / INVITES ============

// Owner-generated invite so staff join the correct clinic/pharmacy via a share
// link or QR code — they never have to guess the facility name. Single-use.
model FacilityInvite {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id])
  token      String   @unique
  role       String   @default("CASHIER") // role granted when this invite is used
  createdBy  String // owner user id
  usesLeft   Int      @default(1)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// ============ BACKUPS ============

// A restorable snapshot of one facility's data. The owner can download it and
// later upload it to recover the whole shop if the server is lost or tampered
// with. Payload is a JSON blob (gzipped is handled at the transport layer).
model Backup {
  id         String   @id @default(uuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  label      String? // e.g. "Monthly auto-backup — 2026-09"
  kind       String   @default("MANUAL") // MANUAL | MONTHLY | PRE_RESTORE
  sizeBytes  Int      @default(0)
  checksum   String? // sha256 of the payload, to detect corruption/tampering
  createdBy  String? // user id
  createdAt  DateTime @default(now())
  payload    Json
}

// ============ DELETE APPROVAL WORKFLOW ============

// Non-owner staff request to delete a transaction/expense with a reason;
// the owner approves or rejects. Owners can delete directly.
model DeleteRequest {
  id            String    @id @default(uuid())
  facilityId    String
  facility      Facility  @relation(fields: [facilityId], references: [id])
  kind          String // SALE or EXPENSE
  targetId      String // sale id or expense id
  reason        String
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  requestedBy   String? // user name snapshot
  requestedById String? // user id
  approvedBy    String? // owner user name
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())
}
